worker_processes auto;
pid /home/serve/run/nginx.pid;
error_log /home/serve/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /home/serve/log/nginx/access.log;

    client_body_temp_path /home/serve/tmp/nginx/client_body;
    proxy_temp_path       /home/serve/tmp/nginx/proxy;
    fastcgi_temp_path     /home/serve/tmp/nginx/fastcgi;
    uwsgi_temp_path       /home/serve/tmp/nginx/uwsgi;
    scgi_temp_path        /home/serve/tmp/nginx/scgi;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 64m;
    server_tokens off;

    server {
        listen ${PORT};
        server_name _;

        root /Lara/public;
        index index.php index.html index.htm;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ ^/(.+)/$ {
            return 301 /$1$is_args$args;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include /etc/nginx/fastcgi_params;
            fastcgi_read_timeout 300;
        }

        location ~ /\. {
            deny all;
        }
    }
}
