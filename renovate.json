{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ILSCeV/renovate-config"
  ],
  "packageRules": [
    {
      "description": "imagick does not compile against PHP 8.6 (XtOffsetOf was removed); remove once imagick supports PHP 8.6.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "allowedVersions": "<8.6"
    }
  ]
}
